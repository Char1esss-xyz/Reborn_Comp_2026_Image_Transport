[Unit]
Description=Hikvision Web Stream Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=reborn
Group=reborn
WorkingDirectory=/home/reborn/桌面/img_transport_demo/build
Environment=LD_LIBRARY_PATH=/home/reborn/桌面/img_transport_demo/hik_sdk/lib
ExecStart=/home/reborn/桌面/img_transport_demo/build/hik_web_stream
StandardInput=null
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
